# Local-only Python OCR and user-trained field classifiers. No model service or API key.
# Never commit .env.
# Optional. Set this on Windows if tesseract.exe is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
MAX_FILE_MB=30
ROUNDING_TOLERANCE=0.02
MINIMUM_FIELD_CONFIDENCE=95
# Defaults to invoice_ai/config/local_data to preserve existing saved history.
# LOCAL_STORAGE_DIR=C:/InvoiceData
